{
  "name": "sijetaistoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jeu de role sur les choix politiques et fiscaux. Le joueur incarne successivement plusieurs personnages et vit les consequences des regles qu'il a lui-meme votees.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:content": "node scripts/build-content.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "dev": "vite",
    "lint:content": "node scripts/lint-content.ts",
    "prebuild": "npm run build:content && npm run lint:content && npm run check:contrast",
    "predev": "npm run build:content",
    "pretest": "npm run build:content && npm run lint:content && npm run check:contrast",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build:content && npm run lint:content && npm run check:contrast && npm run typecheck && npx vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
